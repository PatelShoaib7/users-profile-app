# Frontend Port
VITE_PORT=5173

# Standalone Backend API URL
VITE_API_URL=http://localhost:5000/api
VITE_BACKEND_ORIGIN=http://localhost:5000

# Storage Keys Prefix
VITE_AUTH_STORAGE_PREFIX=peoplepulse

# Enable Dev Role Quick-Login Buttons (set to false in production; zero passwords stored on frontend)
VITE_ENABLE_DEMO_LOGIN=true
