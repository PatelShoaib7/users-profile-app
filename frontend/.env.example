# Frontend Port
VITE_PORT=5173

# Backend API URL & Origin
VITE_API_URL=http://localhost:5000/api
VITE_BACKEND_ORIGIN=http://localhost:5000

# Storage Keys Prefix
VITE_AUTH_STORAGE_PREFIX=peoplepulse

# Dev Role Preview Config (Non-sensitive emails only — zero passwords stored on frontend)
VITE_ENABLE_DEMO_LOGIN=true
VITE_DEMO_ADMIN_EMAIL=admin@example.com
VITE_DEMO_HR_EMAIL=hr@example.com
VITE_DEMO_USER_EMAIL=employee@example.com
