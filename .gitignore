# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment variables (never commit secrets)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Build outputs
dist/
build/
frontend/dist/

# Uploaded & auto-generated static files
backend/uploads/avatars/*
!backend/uploads/avatars/.gitkeep
backend/public/materials/*.pdf

# Logs & OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Test coverage & local dev binary cache
coverage/
backend/coverage/
frontend/coverage/
backend/.cache/
