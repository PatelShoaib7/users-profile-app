# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Required)
MONGO_URI=mongodb://127.0.0.1:27017/your_database_name
ALLOW_IN_MEMORY_DB_FALLBACK=true

# JWT Security (Required - generate a strong 64-character random string)
JWT_SECRET=your_super_secret_jwt_signing_key_here
JWT_EXPIRES_IN=7d

# Allowed Frontend CORS Origins (comma-separated)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Rate Limiting & Upload Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=250
AUTH_RATE_LIMIT_MAX=20
MAX_AVATAR_SIZE_MB=2

# Default Password for Newly Onboarded Users (when Admin/HR leaves password blank)
DEFAULT_NEW_USER_PASSWORD=change_me_on_first_login

# Seed Script Credentials (Used only by `npm run seed` / dev bootstrap)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your_secure_admin_password
SEED_HR_EMAIL=hr@example.com
SEED_HR_PASSWORD=your_secure_hr_password
SEED_USER_EMAIL=employee@example.com
SEED_EMPLOYEE_PASSWORD=your_secure_employee_password
